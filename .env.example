# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://user:password@localhost:5432/avc2026?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Transactional email (magic links + registration confirmations).
# Any SMTP provider: Resend, Postmark, SendGrid, Mailgun.
# Example (Resend): smtp://resend:re_xxxxxxxx@smtp.resend.com:587
EMAIL_SERVER=""
EMAIL_FROM="Africa Volunteering Conference <no-reply@volunteer.africa>"

# When EMAIL_SERVER is unset, magic links are logged to the server console
# instead of being sent. Intended for local development only.
